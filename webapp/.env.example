# ── Backend für die Live-Diagnose (POST /api/diagnose) — PFLICHT ──────────
# Die Diagnose läuft ausschließlich über die OpenAI-Cloud. Es gibt keine
# Demo-/Seed-Geräte. Ohne Key antwortet /api/diagnose mit HTTP 503
# (code: "no_backend") — kein Crash, aber auch kein Demo-Modus.
OPENAI_API_KEY=
# Modell für die Diagnose. Default: gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Modell für die Audio-Transkription (OpenAI Whisper, PROJ-27). Default: whisper-1.
#WHISPER_MODEL=whisper-1

# Vision-Modell für die Bild-/Dokument-Auswertung (PROJ-31). Wird vom Code
# gelesen; ungesetzt gilt das Cloud-Diagnose-Modell (OPENAI_MODEL / gpt-4o-…,
# kann ebenfalls Vision). Auskommentiert lassen = Default nutzen; zum
# Übersteuern ein eigenes Vision-fähiges OpenAI-Modell eintragen.
#VISION_MODEL=gpt-4o

# Timeout in Sekunden für eine LLM-Antwort.
#LLM_TIMEOUT=180

# ── Recherche-Online-Fallback (PROJ-16) ──────────────────────────────────
# SearXNG-Instanz für die optionale Online-Recherche. Leer/ungesetzt = nur
# kuratiert + KI-Fallback, keine Online-Suche.
#SEARXNG_URL=http://localhost:8080

# ── Anfrage-Protokoll / Betreiber-Debug-Log (PROJ-28) ─────────────────────
# Schreibt pro KI-/Fach-Anfrage eine Markdown-Datei nach webapp/protokolle/
# (gitignored, Rohdaten). Default „an". Auf 0 setzen für saubere Testläufe.
#PROTOKOLL_ENABLED=1

# ── Zentrales Logging (PROJ-29) ───────────────────────────────────────────
# Log-Level für Datei (webapp/logs/repair.log, täglich rotiert, 14 Tage) und
# Konsole. Erlaubt: DEBUG, INFO, WARNING, ERROR, CRITICAL. Ungültige Werte
# fallen automatisch auf DEBUG zurück (kein Crash). Default (ungesetzt): DEBUG.
# ⚠ Auf DEBUG landen Klartext-Nutzereingaben im Log — nur lokal/Dev nutzen.
# Für Produktion mindestens INFO setzen.
#LOG_LEVEL=DEBUG

# ── Flask ─────────────────────────────────────────────────────────────────
# Flask-Debug-Modus (1 = an, 0 = aus)
FLASK_DEBUG=1

# ── App-Bindung & Limits (PROJ-30) ────────────────────────────────────────
# Bind-Adresse und Port der App. Im Container z. B. HOST=0.0.0.0 setzen.
# Defaults: 127.0.0.1 / 5000. PORT muss 1..65535 sein, sonst Abbruch beim Start.
#HOST=127.0.0.1
#PORT=5000

# Maximale Mediengröße (Foto/Video/Audio) in Bytes. Default 10485760 (10 MB).
# Muss > 0 sein, sonst Abbruch beim Start.
#MAX_UPLOAD_BYTES=10485760

# ── Vision-Diagnose (PROJ-31) ─────────────────────────────────────────────
# Obergrenze Medien pro Diagnose-Anfrage. Default 6; gültig 1..100 (sonst
# Abbruch beim Start). Bei Überschreitung im UI: Hinweis statt Fehler.
#MAX_MEDIEN_PRO_ANFRAGE=6
# Max. ausgewertete Seiten je beigefügtem PDF. Default 5; gültig 1..50.
# Überzählige Seiten werden mit sichtbarem Hinweis gekürzt.
#MAX_PDF_SEITEN=5
