# OpenAI-Zugang für die Live-Diagnose (optional).
# Ohne Key läuft die App weiter — POST /api/diagnose liefert dann
# das passendste Seed-Gerät als Fallback (source: "fallback").
OPENAI_API_KEY=

# Modell für die Diagnose (Default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Flask-Debug-Modus (1 = an, 0 = aus)
FLASK_DEBUG=1
